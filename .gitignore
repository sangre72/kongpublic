#  OS / 에디터
# ═══════════════════════════════════════════════════════════════
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.bak
*.bak-*
telegram_bot/orchestrator/protocol/archive/
*.pt
*.mp4
*.wav
*.gif
jobs/**/audio/
jobs/**/clips/
telegram_bot/orchestrator/protocol/screenshots/
*.png
*.jpg
*.jpeg
.melo_venv/
