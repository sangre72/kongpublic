<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.kongbot.worker1-tick — a_* 10s tick, session-independent.
  Grok/Claude Monitor dies with the session; Grok background max_runtime=10h.
  launchd KeepAlive restarts the loop. Tick logic stays in worker1_monitor_tick.sh.
  Install: bash telegram_bot/orchestrator/scripts/worker1_ensure_tick.sh
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kongbot.worker1-tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/bumsuklee/miniconda3/bin/python3</string>
    <string>/Users/bumsuklee/git/kong-bot/telegram_bot/orchestrator/scripts/worker1_monitor_loop.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/bumsuklee/git/kong-bot</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>KONG_WORKER_MON1</key>
    <string>1</string>
    <key>PATH</key>
    <string>/Users/bumsuklee/miniconda3/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/bumsuklee/git/kong-bot/logs/worker1_tick_daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/bumsuklee/git/kong-bot/logs/worker1_tick_daemon.err</string>
</dict>
</plist>
