# orchestrator 전용 운영 설정 + 봇 자격증명 템플릿
# 실제 값은 orchestrator/.env 에 넣는다 (.gitignore 로 커밋 제외됨).
# cp .env.example .env 후 값을 채울 것.

# 오케스트레이터 폴링 주기(초)
ORCH_POLL_INTERVAL=5
ORCH_AUTO_DISPATCH=off
ORCH_MAX_WORKERS=1

# 봇 자격증명 (kong-bot 전용 — 개인용, t.me/kong2019_bot)
# BotFather 에서 발급받은 토큰
TELEGRAM_BOT_TOKEN=
# 허용 chat id (본인 것만, 텔레그램 봇에게 /start 후 확인 가능).
# 필수값 — 비어있으면 ask_telegram.py 가 즉시 에러로 중단됨(하드코딩 fallback 없음, 보안).
TELEGRAM_ALLOWED_CHAT_IDS=
